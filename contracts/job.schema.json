{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "job.schema.json",
  "title": "A background job Jarvis is working on",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "label": {
      "type": "string"
    },
    "state": {
      "enum": [
        "running",
        "done",
        "failed"
      ]
    },
    "progress": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "detail": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "label",
    "state"
  ],
  "additionalProperties": false,
  "description": "Real progress only; null when it cannot be measured."
}
