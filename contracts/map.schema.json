{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "map.schema.json",
  "title": "The data of a map window (window.type = map): today's places and the route between them",
  "description": "R2 (REACH §5.2). Carried in window.data so the map draws with the push and needs no extra call. Coordinates are WGS84 degrees. The stop the map leads with is `focus` when given, else the next stop by the clock; only that pin is labelled.",
  "type": "object",
  "properties": {
    "day": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "The local date the stop times are on"
    },
    "start": {
      "type": "string",
      "description": "The place id the day's route starts from (his residence)"
    },
    "places": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]*$"
          },
          "name": {
            "type": "string"
          },
          "short": {
            "type": "string",
            "description": "The label on the pin (a few words)"
          },
          "lat": {
            "type": "number",
            "minimum": -85,
            "maximum": 85
          },
          "lon": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "home": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "lat",
          "lon"
        ],
        "additionalProperties": false
      }
    },
    "stops": {
      "type": "array",
      "description": "The day's stops in time order; the route runs start → each stop's place",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "description": "The day item (day.items[].id) this stop is"
          },
          "place": {
            "type": "string",
            "description": "A places[].id"
          },
          "title": {
            "type": "string"
          },
          "where": {
            "type": "string",
            "description": "The room, as the day item says it"
          },
          "start": {
            "type": "string",
            "pattern": "^\\d{2}:\\d{2}$"
          },
          "end": {
            "type": "string",
            "pattern": "^\\d{2}:\\d{2}$"
          }
        },
        "required": [
          "ref",
          "place",
          "title",
          "start"
        ],
        "additionalProperties": false
      }
    },
    "focus": {
      "type": "string",
      "description": "The stop (its ref) the map leads with: what he asked about. Left out: the next stop"
    }
  },
  "required": [
    "places",
    "stops"
  ],
  "additionalProperties": false
}
