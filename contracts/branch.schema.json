{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "branch.schema.json",
  "title": "A node of the Life Tree",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "parent": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "name": {
      "type": "string"
    },
    "glyph": {
      "type": "string",
      "maxLength": 3
    },
    "kind": {
      "enum": [
        "root",
        "area",
        "branch",
        "leaf",
        "system"
      ]
    },
    "status": {
      "enum": [
        "active",
        "proposed",
        "archived"
      ]
    },
    "tier": {
      "enum": [
        1,
        2
      ]
    },
    "activity": {
      "enum": [
        0,
        1,
        2
      ],
      "description": "Activity in the last 14 days, three sizes only"
    },
    "due": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "label": {
              "type": "string"
            },
            "hours": {
              "type": "number"
            }
          },
          "required": [
            "label",
            "hours"
          ],
          "additionalProperties": false,
          "description": "Nearest due item; \u2264 72 h shows the accent badge"
        },
        {
          "type": "null"
        }
      ]
    },
    "pending": {
      "type": "integer",
      "description": "Approvals waiting on this branch"
    },
    "counts": {
      "type": "object",
      "properties": {
        "due": {
          "type": "integer"
        },
        "open_loops": {
          "type": "integer"
        },
        "facts": {
          "type": "integer"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "summary": {
      "type": "string"
    },
    "thumb": {
      "$ref": "common.schema.json#/$defs/thumb"
    }
  },
  "required": [
    "id",
    "parent",
    "name",
    "glyph",
    "kind",
    "status"
  ],
  "additionalProperties": false
}
