{
  "Name": "JarvisCore",
  "DisplayName": "Jarvis core",
  "Description": "Jarvis back end on Laptop B (python -m jarvis.core). Runs as De Wet's own account so it can reach Credential Manager.",
  "ExecutablePath": "%LOCALAPPDATA%\\JarvisCore\\venv\\Scripts\\python.exe",
  "StartupDirectory": "%JARVIS_REPO%",
  "Parameters": "-m jarvis.core",
  "StartupType": 5,
  "Priority": 2,
  "StartTimeout": 60,
  "StopTimeout": 30,
  "StdoutPath": "C:\\Jarvis\\logs\\servy.stdout.log",
  "StderrPath": "C:\\Jarvis\\logs\\servy.stderr.log",
  "EnableSizeRotation": true,
  "RotationSize": 10,
  "MaxRotations": 5,
  "EnableHealthMonitoring": true,
  "HeartbeatInterval": 30,
  "MaxFailedChecks": 3,
  "RecoveryAction": 2,
  "RecoveryOnCleanExit": true,
  "MaxRestartAttempts": 0,
  "EnvironmentVariables": "JARVIS_ROOT=C:\\Jarvis;JARVIS_CORE_PORT=8770;PYTHONUNBUFFERED=1",
  "PostLaunchExecutablePath": "%LOCALAPPDATA%\\JarvisCore\\venv\\Scripts\\python.exe",
  "PostLaunchStartupDirectory": "%JARVIS_REPO%",
  "PostLaunchParameters": "-m jarvis.core --check --wait 120"
}
